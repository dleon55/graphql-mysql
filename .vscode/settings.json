{
  "workbench.colorCustomizations": {
    "editor.background": "#1A1A1A",         // fondo gris muy oscuro para no forzar la vista
    "editor.foreground": "#FFFFFF",         // texto blanco
    "editorCursor.foreground": "#A28C49",   // cursor dorado institucional
    "editor.selectionBackground": "#9A1B32", // selección en guinda
    "editor.lineHighlightBackground": "#222222",
    "editorIndentGuide.background": "#333333",
    "editorIndentGuide.activeBackground": "#A28C49",
    "editorLineNumber.foreground": "#4A4A4A",

    "sideBar.background": "#1A1A1A",
    "sideBar.foreground": "#FFFFFF",
    "activityBar.background": "#1A1A1A",
    "activityBar.foreground": "#006341",    // verde bandera
    "activityBar.border": "#9A1B32",

    "statusBar.background": "#1A1A1A",
    "statusBar.foreground": "#A28C49",

    "titleBar.activeBackground": "#1A1A1A",
    "titleBar.activeForeground": "#FFFFFF"
  },

  "editor.tokenColorCustomizations": {
    "comments": "#A28C49",     // dorado para comentarios
    "keywords": "#9A1B32",     // guinda para palabras clave
    "strings": "#006341",      // verde para cadenas
    "functions": "#F5F5F5",    // funciones en gris claro
    "numbers": "#A28C49",      // dorado para números
    "types": "#FFFFFF"
  },

  "workbench.colorTheme": "Default Dark+"
}
